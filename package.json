  "description": "Coinbase TS Core used by other libraries and examples",
  "main": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build": "tsc",
    "lint": "eslint . --ext .js,.ts,.mjs",
    "format": "prettier --write \"**/*.{js,mjs,ts,tsx,json,css,md}\""
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:coinbase/core-ts.git"
  },
  "author": "sa@coinbase.com",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/coinbase/core-ts/issues"
  },
  "homepage": "https://github.com/coinbase/core-ts#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.35.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.14.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.6.0",
    "jest": "^29.7.0",
    "prettier": "^3.8.3",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "axios-retry": "^4.5.0"
